# =============================================================================
# ExamCraft AI — Monorepo Master Environment Template
# Duplicate this file to backend/.env and frontend/.env.local for local execution.
# NEVER commit files containing real API keys or credentials to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# [Backend] API Security & Authentication
# -----------------------------------------------------------------------------
API_KEY=examcraft-secret-key-2026
ADMIN_API_KEY=examcraft-admin-key-2026
ENABLE_AUTH=true

# -----------------------------------------------------------------------------
# [Backend] Qdrant Vector Database
# -----------------------------------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
COLLECTION_NAME=class_9_textbooks
QDRANT_BATCH_SIZE=32

# -----------------------------------------------------------------------------
# [Backend] LLM Integration (Gemini 3.8 Flash / OpenAI-compatible endpoint)
# -----------------------------------------------------------------------------
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=your_gemini_api_key_here
LLM_MODEL_NAME=gemini-3.8-flash
MAX_CONTEXT_CHARS=12000

# -----------------------------------------------------------------------------
# [Backend] FastEmbed Embedding Models
# -----------------------------------------------------------------------------
DENSE_MODEL_NAME=BAAI/bge-small-en-v1.5
SPARSE_MODEL_NAME=Qdrant/bm25

# -----------------------------------------------------------------------------
# [Backend] Storage & Upload Configuration
# -----------------------------------------------------------------------------
PDF_TEMP_DIRECTORY=temp_uploads
MAX_UPLOAD_SIZE_MB=1000
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# [Frontend] Web Assessment Studio (Next.js 15)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_CLIENT_KEY=examcraft-secret-key-2026
# Note: Elevated Admin API Key is NEVER stored in client-side environment files.
# Enter your administrator key securely via the Web Studio UI Settings page (stored only in browser LocalStorage).
