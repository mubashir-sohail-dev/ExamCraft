# FastAPI Backend Service Base URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Client Route Authentication Key (Sent via X-API-Key header)
NEXT_PUBLIC_CLIENT_KEY=examcraft-secret-key-2026

# Note: Elevated Admin API Key is NEVER stored in client-side environment files.
# Enter your administrator key securely via the Web Studio UI Settings page (stored only in browser LocalStorage).
