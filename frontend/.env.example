# FastAPI Backend Service Base URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Client Route Authentication Key (Sent via X-API-Key header)
NEXT_PUBLIC_CLIENT_KEY=examcraft-secret-key-2026

# Admin Route Authentication Key (Sent via X-API-Key header for /api/admin/*)
NEXT_PUBLIC_ADMIN_KEY=examcraft-admin-key-2026
