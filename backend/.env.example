# =============================================================================
# ExamCraft AI — Environment Configuration Template
# Duplicate this file to .env and configure your credentials.
# =============================================================================

# API Security & Authentication
API_KEY=examcraft-secret-key-2026
ADMIN_API_KEY=examcraft-admin-key-2026
ENABLE_AUTH=true

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
COLLECTION_NAME=class_9_textbooks
QDRANT_BATCH_SIZE=32

# Large Language Model (Gemini / OpenAI compatible endpoint)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=your_gemini_api_key_here
LLM_MODEL_NAME=gemini-3.8-flash
MAX_CONTEXT_CHARS=30000

# FastEmbed Embedding Models
DENSE_MODEL_NAME=BAAI/bge-small-en-v1.5
SPARSE_MODEL_NAME=Qdrant/bm25

# Storage & Upload Configuration
PDF_TEMP_DIRECTORY=temp_uploads
MAX_UPLOAD_SIZE_MB=1000

# Application Logging (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
